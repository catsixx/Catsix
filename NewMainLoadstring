local BASE = "https://raw.githubusercontent.com/catsixx/Catsix/refs/heads/main/Games/"
local id = tostring(game.PlaceId)
local src = nil
pcall(function()
    src = game:HttpGet(BASE .. id)
end)
if type(src) == "string" and #src > 50 and string.sub(src, 1, 3) ~= "404" then
    print("[Catsix]: Game Supported (" .. id .. ")")
    local f = nil
    pcall(function()
        f = loadstring(src)
    end)
    if type(f) == "function" then
        task.spawn(f)
    else
        print("[Catsix]: Game not Supported")
    end
else
    print("[Catsix]: Game not Supported")
end
