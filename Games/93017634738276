local function toggleFly()
	flyOn = not flyOn
	local c = gc()
	local root = gr()
	local h = gh()
	if not c or not root or not h then flyOn = not flyOn return end
	if flyOn then
		h.PlatformStand = true
		fbv = Instance.new("BodyVelocity")
		fbv.Velocity = Vector3.zero
		fbv.MaxForce = Vector3.new(1e5,1e5,1e5)
		fbv.Parent = root
		fbg = Instance.new("BodyGyro")
		fbg.MaxTorque = Vector3.new(9e4,9e4,9e4)
		fbg.P = 9e4
		fbg.CFrame = root.CFrame
		fbg.Parent = root
		if flyConn then flyConn:Disconnect() end
		flyConn = RS.Heartbeat:Connect(function()
			if not flyOn then return end
			local cam = workspace.CurrentCamera
			if not cam then return end
			local dir = Vector3.zero
			if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0,1,0) end
			if fbv and fbv.Parent then
				fbv.Velocity = dir.Magnitude > 0 and dir.Unit*flyspd or Vector3.zero
			end
			if fbg and fbg.Parent then fbg.CFrame = cam.CFrame end
		end)
		table.insert(conns, flyConn)
	else
		h.PlatformStand = false
		if flyConn then flyConn:Disconnect() flyConn = nil end
		if fbv and fbv.Parent then fbv:Destroy() end
		if fbg and fbg.Parent then fbg:Destroy() end
		fbv, fbg = nil, nil
	end
end

local function toggleGlitch()
	glOn = not glOn
	if glOn then
		if glConn then glConn:Disconnect() end
		glConn = RS.Stepped:Connect(function()
			if not glOn then return end
			local c = gc()
			local h = c and c:FindFirstChildOfClass("Humanoid")
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if not h or not r then return end
			local st = h:GetState()
			if st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall then
				local md = h.MoveDirection
				if md.Magnitude > 0.1 then
					r.AssemblyLinearVelocity = Vector3.new(md.X * glSpd, r.AssemblyLinearVelocity.Y, md.Z * glSpd)
				end
			end
		end)
		table.insert(conns, glConn)
	else
		if glConn then glConn:Disconnect() glConn = nil end
	end
end

