local function equipGun()
	local c = gc()
	if not c then return nil end
	local gun = c:FindFirstChild("Gun")
	if gun then return gun end
	if lp.Backpack then
		local bp = lp.Backpack:FindFirstChild("Gun")
		if bp then
			local h = gh()
			if h then h:EquipTool(bp) task.wait(0.1) end
			return c:FindFirstChild("Gun")
		end
	end
end

local function fireVolley(gun, hand, tgt)
	local hr = tgt:FindFirstChild("HumanoidRootPart")
	if not hr then return false end
	local head = tgt:FindFirstChild("Head")
	local upper = tgt:FindFirstChild("UpperTorso") or tgt:FindFirstChild("Torso")
	local parts = {hr}
	if upper then table.insert(parts, 2, upper) end
	if head then table.insert(parts, head) end
	local origin = CFrame.new(hand.Position)
	local best = hr.Position
	local t = 0.12
	for _, part in ipairs(parts) do
		if part and part.Parent then
			local v = part.Velocity
			local a = part.Position
			if v.Magnitude > 1 then
				if v.Magnitude > 60 then v = v.Unit * 60 end
				a = part.Position + v * t
			end
			best = a
			pcall(function() gun.Shoot:FireServer(origin, CFrame.new(a)) end)
			pcall(function() gun.Shoot:FireServer(a) end)
			pcall(function() gun.Shoot:FireServer(tgt, a) end)
			pcall(function() gun.Shoot:FireServer(tgt) end)
			if head then pcall(function() gun.Shoot:FireServer(head) end) end
		end
	end
	for i = 1, 14 do pcall(function() gun.Shoot:FireServer(origin, CFrame.new(best)) end) end
	return true
end

local function shootMurder()
	pcall(function()
		local c = gc()
		if not c then return end
		local m = findMurder()
		if not m or not m.Character then notif("Shoot", "no murderer", 2) return end
		local tgt = m.Character:FindFirstChild("HumanoidRootPart") or m.Character:FindFirstChild("Head")
		if not tgt then return end
		local root = gr()
		if not root then return end
		local gun = equipGun()
		if not gun then notif("Shoot", "no gun", 2) return end
		local hand = c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm")
		if gun:FindFirstChild("Shoot") and hand then
			fireVolley(gun, hand, m.Character)
			notif("Shoot", "fired", 2)
		end
	end)
end

local function toggleAutoShoot()
	asOn = not asOn
	if asOn then
		if asConn then asConn:Disconnect() end
		asConn = RS.Heartbeat:Connect(function()
			if not asOn then return end
			local now = tick()
			if now - lastShot < 1 then return end
			pcall(function()
				local c = gc()
				if not c then return end
				local hasGun = c:FindFirstChild("Gun") or (lp.Backpack and lp.Backpack:FindFirstChild("Gun"))
				if not hasGun then return end
				local m = findMurder()
				if not m or not m.Character then return end
				local tgt = m.Character:FindFirstChild("HumanoidRootPart") or m.Character:FindFirstChild("Head")
				if not tgt then return end
				local root = gr()
				if not root then return end
				if not hasLOS(root.Position, tgt.Position, {c, m.Character}) then return end
				local gun = equipGun()
				if not gun then return end
				local hand = c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm")
				if gun:FindFirstChild("Shoot") and hand then
					lastShot = tick()
					fireVolley(gun, hand, m.Character)
				end
			end)
		end)
		table.insert(conns, asConn)
	else
		if asConn then asConn:Disconnect() asConn = nil end
	end
end

