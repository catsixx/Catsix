local function saveFile(path, val)
	pcall(function()
		if not (isfolder and makefolder and writefile) then return end
		if not isfolder(FOLDER) then makefolder(FOLDER) end
		writefile(path, tostring(val))
	end)
end

local function readFile(path, def)
	local ok, v = pcall(function()
		if isfile and readfile and isfile(path) then return tonumber(readfile(path)) end
	end)
	return (ok and v) or def
end

