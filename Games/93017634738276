						break
					end
				end
			end
		end)
		if not hopped then
			pcall(function() TPS:Teleport(game.PlaceId, lp) end)
		end
	end)
	notif("Serverhop", "hopping...", 2)
end

local function saveConfig()
	pcall(function()
		if not (isfolder and makefolder and writefile) then notif("Config", "no fs", 2) return end
		if not isfolder(FOLDER) then makefolder(FOLDER) end
		writefile(CFG, HS:JSONEncode({
			ws = ws, jp = jp, flyspd = flyspd, glSpd = glSpd,
			ncOn = ncOn, ijOn = ijOn, invOn = invOn, glOn = glOn,
			asOn = asOn, agOn = agOn, acOn = acOn, ac2On = ac2On,
			espM = espM, espS = espS, espI = espI, espAll = espAll,
			alagOn = alagOn, aafkOn = aafkOn, afOn = afOn,
		}))
		notif("Config", "saved", 2)
	end)
end

local function loadConfig()
	pcall(function()
		if not (isfile and readfile) then notif("Config", "no fs", 2) return end
		if not isfile(CFG) then notif("Config", "no config found", 2) return end
		local cfg = HS:JSONDecode(readfile(CFG))
		if cfg.ws then ws = cfg.ws saveFile(SPF,ws) applySpd() end
		if cfg.jp then jp = cfg.jp saveFile(JPF,jp) applySpd() end
		if cfg.flyspd then flyspd = cfg.flyspd end
		if cfg.glSpd then glSpd = cfg.glSpd end
		if cfg.ncOn ~= nil and cfg.ncOn ~= ncOn then toggleNoclip() end
		if cfg.ijOn ~= nil and cfg.ijOn ~= ijOn then toggleInfJump() end
		if cfg.invOn ~= nil and cfg.invOn ~= invOn then toggleInvis() end
		if cfg.glOn ~= nil and cfg.glOn ~= glOn then toggleGlitch() end
		if cfg.asOn ~= nil and cfg.asOn ~= asOn then toggleAutoShoot() end
		if cfg.agOn ~= nil and cfg.agOn ~= agOn then toggleAutoGrab() end
		if cfg.acOn ~= nil and cfg.acOn ~= acOn then toggleAutoCollect() end
		if cfg.ac2On ~= nil and cfg.ac2On ~= ac2On then toggleAutoCoins() end
		if cfg.espM ~= nil then espM = cfg.espM updateESP() end
		if cfg.espS ~= nil then espS = cfg.espS updateESP() end
		if cfg.espI ~= nil then espI = cfg.espI updateESP() end
		if cfg.espAll ~= nil then espAll = cfg.espAll updateESP() end
		if cfg.alagOn ~= nil and cfg.alagOn ~= alagOn then toggleAntiLag() end
		if cfg.aafkOn ~= nil and cfg.aafkOn ~= aafkOn then toggleAntiAFK() end
		if cfg.afOn ~= nil and cfg.afOn ~= afOn then toggleAntiFling() end
		notif("Config", "loaded", 2)
	end)
end

local function runCmd(msg)
	if not msg or msg == "" then return end
	msg = msg:match("^%s*(.-)%s*$")
	if msg == "" or msg:sub(1,1) ~= "/" then return end
	local parts = msg:split(" ")
	local cmd = parts[1]:lower()
	local a1r = parts[2] or ""
	local a1 = a1r:lower()
	if cmd == "/fly" then toggleFly()
	elseif cmd == "/noclip" then toggleNoclip()
	elseif cmd == "/infjump" then toggleInfJump()
	elseif cmd == "/invis" then toggleInvis()
	elseif cmd == "/speedglitch" then toggleGlitch()
	elseif cmd == "/shoot" then shootMurder()
	elseif cmd == "/autoshoot" then toggleAutoShoot()
	elseif cmd == "/grab" then grabGun()
	elseif cmd == "/autograb" then toggleAutoGrab()
	elseif cmd == "/autocollect" then toggleAutoCollect()
	elseif cmd == "/autocoins" then toggleAutoCoins()
	elseif cmd == "/antifling" then toggleAntiFling()
	elseif cmd == "/antiafk" then toggleAntiAFK()
	elseif cmd == "/antilag" then toggleAntiLag()
	elseif cmd == "/rejoin" then doRejoin()
	elseif cmd == "/serverhop" then doServerhop()
	elseif cmd == "/saveconfig" then saveConfig()
	elseif cmd == "/loadconfig" then loadConfig()
	elseif cmd == "/espmurder" then espM = not espM updateESP() notif("ESP Murder", espM and "on" or "off", 2)
	elseif cmd == "/espsheriff" then espS = not espS updateESP() notif("ESP Sheriff", espS and "on" or "off", 2)
	elseif cmd == "/espinnocent" then espI = not espI updateESP() notif("ESP Innocnt", espI and "on" or "off", 2)
	elseif cmd == "/espall" then espAll = not espAll updateESP() notif("ESP All", espAll and "on" or "off", 2)
	elseif cmd == "/speed" then
		local v = tonumber(a1r)
		if v then ws = math.clamp(v,1,999) saveFile(SPF,ws) applySpd() notif("Speed","-> "..ws,2)
		else notif("Speed","usage: /speed <n>",2) end
	elseif cmd == "/jump" then
		local v = tonumber(a1r)
		if v then jp = math.clamp(v,1,999) saveFile(JPF,jp) applySpd() notif("Jump","-> "..jp,2)
		else notif("Jump","usage: /jump <n>",2) end
	elseif cmd == "/flyspeed" then
		local v = tonumber(a1r)
		if v then flyspd = math.clamp(v,1,300) notif("FlySpeed","-> "..flyspd,2)
		else notif("FlySpeed","usage: /flyspeed <n>",2) end
	elseif cmd == "/tp" then
		if a1 == "murder" then tpToMurder()
		elseif a1 == "gun" then tpToGun()
		elseif a1 == "lobby" then tpToLobby()
		elseif a1 == "map" then tpToMap()
		elseif a1r ~= "" then tpToPlayer(a1r)
		else notif("TP","usage: /tp <murder|gun|lobby|map|name>",3) end
	elseif cmd == "/fling" then
		if a1r ~= "" then flingPlayer(a1r)
		else notif("Fling","usage: /fling <name>",2) end
	else notif("Catsix", "unknown: "..cmd, 2) end
end

