end

local function mkHL(parent, color)
	local h = Instance.new("Highlight")
	h.FillColor = color
	h.OutlineColor = Color3.new(1,1,1)
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.FillTransparency = 0.3
	h.Parent = parent
	return h
end

local function applySpd()
	local h = gh()
	if not h then return end
	if h.WalkSpeed ~= ws then h.WalkSpeed = ws end
	if h.JumpPower ~= jp then h.JumpPower = jp end
end

local function startSpdLoop()
	if spdConn then spdConn:Disconnect() end
	applySpd()
	local t = 0
	spdConn = RS.Stepped:Connect(function(_, dt)
		t += dt
		if t < 0.2 then return end
		t = 0
		applySpd()
	end)
	table.insert(conns, spdConn)
end

local function clearPEsp()
	for _, h in pairs(espCache) do pcall(function() h:Destroy() end) end
	espCache = {}
end

local function rebuildEspP(player)
	if player == lp or not player.Character then return end
	local c = player.Character
	local hk = c:FindFirstChild("Knife") or (player.Backpack and player.Backpack:FindFirstChild("Knife"))
	local hg = c:FindFirstChild("Gun") or (player.Backpack and player.Backpack:FindFirstChild("Gun"))
	local col
	local allOn = espAll
	if (espM or allOn) and hk then col = Color3.fromRGB(255,0,0)
	elseif (espS or allOn) and hg then col = Color3.fromRGB(0,100,255)
	elseif (espI or allOn) and not hk and not hg then col = Color3.fromRGB(0,255,0)
	elseif allOn then col = Color3.fromRGB(200,200,200)
	end
	local ex = espCache[player]
	if col then
		if ex and ex.Parent == c then
			ex.FillColor = col
		else
			if ex then pcall(function() ex:Destroy() end) end
			espCache[player] = mkHL(c, col)
		end
	else
		if ex then pcall(function() ex:Destroy() end) espCache[player] = nil end
	end
end

local function updateESP()
	if not (espAll or espM or espS or espI) then clearPEsp() return end
	for p, h in pairs(espCache) do
		if not p.Character or not h.Parent then
			pcall(function() h:Destroy() end)
			espCache[p] = nil
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do rebuildEspP(p) end
end



local function startEspLoop()
	if espConn then espConn:Disconnect() end
	local t = 0
	espConn = RS.Stepped:Connect(function(_, dt)
		t += dt
		if t < 0.5 then return end
		t = 0
		pcall(updateESP)
	end)
	table.insert(conns, espConn)

	local pac = Players.PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(function()
			task.wait(0.5)
			pcall(function() rebuildEspP(p) end)
		end)
	end)
	table.insert(conns, pac)

	for _, p in ipairs(Players:GetPlayers()) do
		if p == lp then continue end
		local rc = p.CharacterAdded:Connect(function()
			task.wait(0.5)
			pcall(function() rebuildEspP(p) end)
		end)
		table.insert(conns, rc)
	end
end

