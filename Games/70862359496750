local function flyEnsure(c, root)
    local bv = root:FindFirstChild("CatsixFlyV")
    local bg = root:FindFirstChild("CatsixFlyG")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "CatsixFlyV"
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = root
    end
    if not bg then
        bg = Instance.new("BodyGyro")
        bg.Name = "CatsixFlyG"
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.P = 9000
        bg.Parent = root
    end
    return bv, bg
end

local function flyOff()
    local c = lp.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if root then
        local bv = root:FindFirstChild("CatsixFlyV")
        if bv then bv:Destroy() end
        local bg = root:FindFirstChild("CatsixFlyG")
        if bg then bg:Destroy() end
    end
    FlyUp = false
    FlyDown = false
end

RunService.Heartbeat:Connect(function()
    if not FlyOn then return end
    local c = lp.Character
    if not c then return end
    local root = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    local bv, bg = flyEnsure(c, root)
    local dir = hum.MoveDirection * FlySpeed
    if FlyUp then dir = dir + Vector3.new(0, FlySpeed, 0) end
    if FlyDown then dir = dir + Vector3.new(0, -FlySpeed, 0) end
    bv.Velocity = dir
    local cam = Workspace.CurrentCamera
    if cam then
        bg.CFrame = CFrame.new(root.Position, root.Position + cam.CFrame.LookVector)
    end
end)

