local function farmTool(c)
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then
            local nm = string.lower(t.Name)
            if not string.find(nm, "fake") and not string.find(nm, "bomb") then
                return t
            end
        end
    end
    local pack = lp:FindFirstChildOfClass("Backpack")
    if pack then
        for _, t in ipairs(pack:GetChildren()) do
            if t:IsA("Tool") then
                local nm = string.lower(t.Name)
                if not string.find(nm, "fake") and not string.find(nm, "bomb") then
                    local hum = c:FindFirstChildOfClass("Humanoid")
                    if hum then pcall(function() hum:EquipTool(t) end) end
                    task.wait(0.15)
                    local eq = c:FindFirstChild(t.Name)
                    if eq then return eq end
                end
            end
        end
    end
    return nil
end

local function farmNext()
    local c = lp.Character
    if not c then return nil end
    local root = c:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local hm = c:FindFirstChild("Head")
    local from = root.Position
    if hm then from = hm.Position end
    local best = nil
    local bd = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and alive(p) then
            local ch = p.Character
            local hr = ch and ch:FindFirstChild("HumanoidRootPart")
            if hr then
                local d = (hr.Position - root.Position).Magnitude
                if d < bd then
                    bd = d
                    best = p
                end
            end
        end
    end
    return best
end

local function farmKnife(c)
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") and t:FindFirstChild("KnifeStabbed", true) then
            return t
        end
    end
    local pack = lp:FindFirstChildOfClass("Backpack")
    if pack then
        for _, t in ipairs(pack:GetChildren()) do
            if t:IsA("Tool") and t:FindFirstChild("KnifeStabbed", true) then
                local hum = c:FindFirstChildOfClass("Humanoid")
                if hum then pcall(function() hum:EquipTool(t) end) end
                task.wait(0.15)
                local eq = c:FindFirstChild(t.Name)
                if eq then return eq end
            end
        end
    end
    return nil
end

local function farmStep()
    local c = lp.Character
    if not c then return end
    local root = c:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if FarmTarget == nil or not alive(FarmTarget) or FarmTarget.Parent == nil then
        FarmTarget = farmNext()
        if FarmTarget == nil then
            if FarmHome then
                pcall(function()
                    if (root.Position - FarmHome.Position).Magnitude > 6 then
                        root.CFrame = FarmHome
                    end
                end)
            end
            task.wait(0.5)
            return
        end
        task.wait(0.15)
    end
    local tch = FarmTarget.Character
    if not tch then return end
    local thr = tch:FindFirstChild("HumanoidRootPart")
    if not thr then return end
    local thead = tch:FindFirstChild("Head")
    for _, v in ipairs(c:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
        end
    end
    pcall(function()
        root.CFrame = thr.CFrame * CFrame.new(0, -3, 0)
    end)
    local knife = farmKnife(c)
    if knife then
        pcall(function() knife:Activate() end)
        local stab = knife:FindFirstChild("KnifeStabbed", true)
        local touch = knife:FindFirstChild("HandleTouched", true)
        if stab then
            pcall(function() stab:FireServer(tch) end)
            pcall(function() stab:FireServer(thr) end)
            if thead then pcall(function() stab:FireServer(thead) end) end
            pcall(function() stab:FireServer(thr.Position) end)
        end
        if touch then
            pcall(function() touch:FireServer(thr) end)
            if thead then pcall(function() touch:FireServer(thead) end) end
            pcall(function() touch:FireServer(tch) end)
        end
        return
    end
    local tool = farmTool(c)
    if not tool then return end
    pcall(function() tool:Activate() end)
    local r = remoteOf(tool)
    if r then
        local hum = tch:FindFirstChildOfClass("Humanoid")
        local a = thr.Position
        if hum then
            a = hum.Position
        end
        local origin = CFrame.new(root.Position)
        pcall(function() r:FireServer(origin, CFrame.new(a)) end)
        pcall(function() r:FireServer(a) end)
        pcall(function() r:FireServer(tch, a) end)
    end
end

