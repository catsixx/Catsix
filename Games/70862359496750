        local UiSec = SettingsTab:Section({ Title = "UI Settings", Opened = true })

        UiSec:Keybind({
            Title = "UI Toggle Key",
            Desc = "Show / hide Catsix",
            Value = "K",
            Callback = function(v)
                pcall(function() Window:SetToggleKey(Enum.KeyCode[v]) end)
            end,
        })

        UiSec:Dropdown({
            Title = "Theme",
            Values = { "Catsix Black", "Dark", "Light" },
