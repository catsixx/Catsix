RunService.Stepped:Connect(function()
    local c = lp.Character
    if not c then return end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hum then
        if Settings.SpeedEnabled then
            if hum.WalkSpeed ~= Settings.WalkSpeed then
                hum.WalkSpeed = Settings.WalkSpeed
            end
        end
        if Settings.JumpEnabled then
            pcall(function()
                if hum.UseJumpPower then
                    if hum.JumpPower ~= Settings.JumpPower then
                        hum.JumpPower = Settings.JumpPower
                    end
                else
                    if hum.JumpHeight ~= Settings.JumpHeight then
                        hum.JumpHeight = Settings.JumpHeight
                    end
                end
            end)
        end
    end
    if Settings.Noclip then
        for _, v in ipairs(c:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then
                v.CanCollide = false
            end
        end
    end
    if Settings.Glitch and hum then
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall then
            local md = hum.MoveDirection
            if md.Magnitude > 0.1 then
                local root2 = c:FindFirstChild("HumanoidRootPart")
                if root2 then
                    local vy = root2.AssemblyLinearVelocity.Y
                    root2.AssemblyLinearVelocity = Vector3.new(md.X * Settings.GlitchSpeed, vy, md.Z * Settings.GlitchSpeed)
                end
            end
        end
    end
end)

RunService.Heartbeat:Connect(function(dt)
    local c = lp.Character
    if not c then return end
    local hum = c:FindFirstChildOfClass("Humanoid")
    local root = c:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end
    if Settings.Fly then
        if hum.PlatformStand ~= true then
            hum.PlatformStand = true
        end
        pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false) end)
        local cam = Workspace.CurrentCamera
        if cam then
            local cf = cam.CFrame
            local dir = Vector3.new()
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
            if dir.Magnitude > 0 then
                root.CFrame = root.CFrame + dir.Unit * Settings.FlySpeed * dt
            end
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    else
        if hum.PlatformStand ~= false then
            hum.PlatformStand = false
        end
        pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end)
    end
end)

