        MoveSec:Toggle({
            Title = "Gravity Enabled",
            Value = false,
            Flag = "GravityEnabled",
            Callback = function(v) Settings.GravityEnabled = v end,
        })

        MoveSec:Slider({
            Title = "Gravity",
            Step = 1,
            Value = { Min = 0, Max = 500, Default = 196 },
            Flag = "Gravity",
            Callback = function(v)
                Settings.Gravity = v
                if Settings.GravityEnabled then
                    pcall(function() Workspace.Gravity = v end)
                end
            end,
        })

        local UtilSec = PlayerTab:Section({ Title = "Utility", Opened = true })

        UtilSec:Toggle({
            Title = "Infinite Jump",
            Value = false,
            Flag = "InfJump",
            Callback = function(v) Settings.InfJump = v end,
