local SpyOn = false
local CatsixOldNamecall = nil

local function CatsixFullName(inst)
    local ok2, res = pcall(function() return inst:GetFullName() end)
    if ok2 and res then return res end
    return inst.Name
end

local function CatsixFindRemotes()
    local found = {}
    pcall(function()
        for _, d in ipairs(game:GetDescendants()) do
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") or d:IsA("BindableEvent") or d:IsA("BindableFunction") then
                table.insert(found, d)
            end
        end
    end)
    return found
end

local function CatsixScanPrint()
    local found = CatsixFindRemotes()
    local lines = {}
    for _, r in ipairs(found) do
        table.insert(lines, r.ClassName .. " | " .. CatsixFullName(r))
    end
    print("[Catsix] Remotes found: " .. tostring(#found))
    for _, ln in ipairs(lines) do
        print("[Catsix Remote] " .. ln)
    end
    if setclipboard then
        pcall(function() setclipboard(table.concat(lines, "\n")) end)
    end
    return found
end


local function CatsixEnableSpy()
    if CatsixOldNamecall ~= nil then return end
    pcall(function()
        for _, r in ipairs(CatsixFindRemotes()) do
            if r:IsA("RemoteEvent") then
                pcall(function()
                    r.OnClientEvent:Connect(function(...)
                        if SpyOn then
                            print("[Catsix Spy In] " .. CatsixFullName(r))
                        end
                    end)
                end)
            end
        end
    end)
    pcall(function()
        if hookmetamethod and getnamecallmethod and newcclosure and checkcaller and getrawmetatable then
            local mt = getrawmetatable(game)
            if mt then
                pcall(function() setreadonly(mt, false) end)
                CatsixOldNamecall = mt.__namecall
                mt.__namecall = newcclosure(function(self, ...)
                    local m = getnamecallmethod()
                    if SpyOn then
                        pcall(function()
                            if checkcaller() == false then
                                if m == "FireServer" or m == "InvokeServer" then
                                    if self and (self.ClassName == "RemoteEvent" or self.ClassName == "RemoteFunction") then
                                        print("[Catsix Spy] " .. m .. " | " .. CatsixFullName(self))
                                    end
                                end
                            end
                        end)
                    end
                    return CatsixOldNamecall(self, ...)
                end)
                pcall(function() setreadonly(mt, true) end)
            end
        end
    end)
end









local function CatsixDeepScan()
    local out = {}
    local function push(s) table.insert(out, s) end
    pcall(function() push("PLACE " .. tostring(game.PlaceId)) end)
    pcall(function() push("JOB " .. tostring(game.JobId)) end)
    pcall(function() push("PLAYERS " .. tostring(#Players:GetPlayers())) end)
    pcall(function()
        local names = {}
        for _, p in ipairs(Players:GetPlayers()) do
            table.insert(names, p.Name)
        end
        push("NAMES " .. table.concat(names, ", "))
    end)
    pcall(function()
        push("REPLICATED_TOP:")
        local rs = game:GetService("ReplicatedStorage")
        local n = 0
        for _, d in ipairs(rs:GetChildren()) do
            n = n + 1
            if n <= 80 then
                push("  " .. d.ClassName .. " | " .. d.Name)
            end
        end
        push("  TOTAL_TOP " .. tostring(n))
    end)
    pcall(function()
        push("REMOTES:")
        local n = 0
        for _, d in ipairs(game:GetDescendants()) do
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                n = n + 1
                if n <= 150 then
                    local full = d.Name
                    pcall(function() full = d:GetFullName() end)
                    push("  " .. d.ClassName .. " | " .. d.Name .. " | " .. full)
                end
            end
        end
        push("  TOTAL_REMOTES " .. tostring(n))
    end)
    pcall(function()
        push("TOOLS:")
        for _, d in ipairs(game:GetDescendants()) do
            if d:IsA("Tool") then
                local full = d.Name
                pcall(function() full = d:GetFullName() end)
                local rem = {}
                for _, c in ipairs(d:GetDescendants()) do
                    if c:IsA("RemoteEvent") or c:IsA("RemoteFunction") then
                        table.insert(rem, c.ClassName .. ":" .. c.Name)
                    end
                end
                push("  Tool | " .. d.Name .. " | " .. full .. " | remotes [" .. table.concat(rem, ", ") .. "]")
            end
        end
    end)
    pcall(function()
        local pack = lp:FindFirstChildOfClass("Backpack")
        if pack then
            push("BACKPACK:")
            for _, t in ipairs(pack:GetChildren()) do
                push("  " .. t.ClassName .. " | " .. t.Name)
            end
        end
        if lp.Character then
            push("CHARACTER:")
            for _, t in ipairs(lp.Character:GetChildren()) do
                if t:IsA("Tool") or t:IsA("Humanoid") then
                    push("  " .. t.ClassName .. " | " .. t.Name)
                end
            end
        end
    end)
    pcall(function()
        local ls = lp:FindFirstChild("leaderstats")
        if ls then
            push("LEADERSTATS:")
            for _, v in ipairs(ls:GetChildren()) do
                push("  " .. v.ClassName .. " | " .. v.Name .. " | " .. tostring(v.Value))
            end
        else
            push("LEADERSTATS none")
        end
    end)
    local txt = table.concat(out, "\n")
    print("[Catsix Scan] len " .. tostring(string.len(txt)))
    print(txt)
    if setclipboard then
        pcall(function() setclipboard(txt) end)
    end
    pcall(function()
        if writefile then
            writefile("CatsixScan.txt", txt)
        end
    end)
    return txt
end

