local KNIFEKEY = Enum.KeyCode.T
local klast = 0

local function knifeTool(c)
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") and t:FindFirstChild("KnifeThrown", true) then
            return t
        end
    end
    local pack = lp:FindFirstChildOfClass("Backpack")
    if pack then
        for _, t in ipairs(pack:GetChildren()) do
            if t:IsA("Tool") and t:FindFirstChild("KnifeThrown", true) then
                local hum = c:FindFirstChildOfClass("Humanoid")
                if hum then pcall(function() hum:EquipTool(t) end) end
                task.wait(0.15)
                local eq = c:FindFirstChild(t.Name)
                if eq then return eq end
            end
        end
    end
    return nil
end

local function throwKnife()
    if Settings.ShootEnabled == false then return end
    if tick() - klast < CD then return end
    local c = lp.Character
    if not c then return end
    local root = c:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local hm = c:FindFirstChild("Head")
    local from = root.Position
    if hm then from = hm.Position end
    local target = closestVisible(root.Position, from)
    if not target then return end
    local tch = target.Character
    if not tch then return end
    local tool = knifeTool(c)
    if not tool then return end
    local thrown = tool:FindFirstChild("KnifeThrown", true)
    if not thrown then return end
    local hr = tch:FindFirstChild("HumanoidRootPart")
    if not hr then return end
    local head = tch:FindFirstChild("Head")
    local upper = tch:FindFirstChild("UpperTorso") or tch:FindFirstChild("Torso")
    local t = tt()
    local parts = {}
    if upper then table.insert(parts, upper) end
    if hr then table.insert(parts, hr) end
    if head then table.insert(parts, head) end
    local aims = {}
    for _, part in ipairs(parts) do
        if part and part.Parent and clearShot(from, part, tch) then
            local vel = part.Velocity
            local aim = part.Position
            if vel.Magnitude > 1 then
                if vel.Magnitude > 60 then vel = vel.Unit * 60 end
                aim = part.Position + vel * t
            end
            table.insert(aims, aim)
        end
    end
    if #aims == 0 then
        if not clearShot(from, hr, tch) then return end
        table.insert(aims, hr.Position)
    end
    klast = tick()
    local hand = c:FindFirstChild("RightHand")
    if not hand then hand = root end
    local origin = CFrame.new(hand.Position)
    local stab = tool:FindFirstChild("KnifeStabbed", true)
    for _, a in ipairs(aims) do
        pcall(function() thrown:FireServer(origin, CFrame.new(a)) end)
        pcall(function() thrown:FireServer(a) end)
        pcall(function() thrown:FireServer(tch, a) end)
        if stab then
            pcall(function() stab:FireServer(tch) end)
            pcall(function() stab:FireServer(a) end)
        end
    end
    local reps = 6
    if Settings.HitChance >= 100 then reps = 14 end
    for i = 1, reps do
        pcall(function() thrown:FireServer(origin, CFrame.new(aims[1])) end)
    end
end

