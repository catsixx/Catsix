local function farmTool(c)
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then
            local nm = string.lower(t.Name)
            if not string.find(nm, "fake") and not string.find(nm, "bomb") then
                return t
            end
        end
    end
    local pack = lp:FindFirstChildOfClass("Backpack")
    if pack then
        for _, t in ipairs(pack:GetChildren()) do
            if t:IsA("Tool") then
                local nm = string.lower(t.Name)
                if not string.find(nm, "fake") and not string.find(nm, "bomb") then
                    local hum = c:FindFirstChildOfClass("Humanoid")
                    if hum then pcall(function() hum:EquipTool(t) end) end
                    task.wait(0.15)
                    local eq = c:FindFirstChild(t.Name)
                    if eq then return eq end
                end
            end
        end
    end
    return nil
end

local function farmStep()
    local c = lp.Character
    if not c then return end
    local root = c:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local from = root.Position
    local hm = c:FindFirstChild("Head")
    if hm then from = hm.Position end
    local target = closestVisible(root.Position, from)
    if not target or not target.Character then return end
    local tch = target.Character
    local thr = tch:FindFirstChild("HumanoidRootPart")
    if not thr then return end
    for _, v in ipairs(c:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
        end
    end
    pcall(function()
        root.CFrame = thr.CFrame * CFrame.new(0, -4, 0)
    end)
    local tool = farmTool(c)
    if not tool then return end
    pcall(function() tool:Activate() end)
    pcall(function() tool:Activate() end)
end

