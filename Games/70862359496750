local function CatsixKillNotify(on)
    if on then
        if KillConn then return end
        pcall(function()
            local r = game:GetService("ReplicatedStorage").Remotes.Combat.KillEvent
            if r then
                KillConn = r.OnClientEvent:Connect(function(...)
                    local a = {...}
                    local msg = "Kill"
                    if #a > 0 and typeof(a[1]) == "string" then
                        msg = a[1]
                    elseif #a > 1 and typeof(a[2]) == "string" then
                        msg = a[2]
                    end
                    WindUI:Notify({ Title = "Catsix Kill", Content = tostring(msg), Duration = 2, Icon = "swords" })
                end)
            end
        end)
    else
        if KillConn then
            pcall(function() KillConn:Disconnect() end)
            KillConn = nil
        end
    end
end


