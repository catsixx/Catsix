    do
        local EspSec = VisualTab:Section({ Title = "ESP", Opened = true })

        EspSec:Toggle({
            Title = "Player ESP (Highlight)",
            Desc = "Green highlight, loops",
            Value = false,
            Flag = "ESPEnabled",
            Callback = function(v)
                Settings.ESPEnabled = v
                if not v then
                    for _, p in ipairs(Players:GetPlayers()) do
                        local ch = p.Character
                        local old = ch and ch:FindFirstChild("CatsixESP")
                        if old then old:Destroy() end
                    end
                end
            end,
        })

        local WorldSec = VisualTab:Section({ Title = "World / Camera", Opened = true })

        WorldSec:Toggle({
            Title = "FOV Enabled",
            Value = false,
            Flag = "FOVEnabled",
            Callback = function(v) Settings.FOVEnabled = v end,
        })

        WorldSec:Slider({
            Title = "FOV",
            Step = 1,
            Value = { Min = 60, Max = 120, Default = 70 },
            Flag = "FOV",
            Callback = function(v)
                Settings.FOV = v
                if Settings.FOVEnabled then
                    local cam = Workspace.CurrentCamera
                    if cam then pcall(function() cam.FieldOfView = v end) end
                end
            end,
        })

        WorldSec:Toggle({
            Title = "Fullbright",
            Value = false,
            Flag = "Fullbright",
            Callback = function(v)
                Settings.Fullbright = v
                if not v then
                    Lighting.Ambient = Color3.fromRGB(0, 0, 0)
                    Lighting.Brightness = 1
                    Lighting.GlobalShadows = true
                end
            end,
        })

        WorldSec:Toggle({
            Title = "No Fog",
            Value = false,
            Flag = "NoFog",
            Callback = function(v) Settings.NoFog = v end,
        })
    end

    do
        local PerSec = MiscTab:Section({ Title = "Performance", Opened = true })

        PerSec:Button({
            Title = "FPS Boost",
            Desc = "Low graphics for max FPS",
            Icon = "zap",
            Callback = function()
                pcall(function()
                    Lighting.GlobalShadows = false
                    Lighting.FogEnd = 9e9
                    for _, v in ipairs(Workspace:GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.Material = Enum.Material.SmoothPlastic
                            v.Reflectance = 0
                        elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
                            v.Enabled = false
                        end
                    end
                    for _, e in ipairs(Lighting:GetChildren()) do
                        if e:IsA("PostEffect") or e:IsA("Atmosphere") then
                            e.Enabled = false
                        end
                    end
                end)
                WindUI:Notify({ Title = "Catsix", Content = "FPS Boost applied!", Duration = 2, Icon = "check" })
            end,
        })

        PerSec:Toggle({
            Title = "Anti-AFK",
            Value = false,
            Flag = "AntiAFK",
            Callback = function(v) Settings.AntiAFK = v end,
