local function tpTo(name)
    if not name or name == "none" then return false end
    local p = Players:FindFirstChild(name)
    if not p or not p.Character then return false end
    local thr = p.Character:FindFirstChild("HumanoidRootPart")
    local c = lp.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not thr or not root then return false end
    pcall(function()
        root.CFrame = thr.CFrame + Vector3.new(0, 3, 0)
    end)
    return true
end

task.spawn(function()
    while true do
        if FollowOn and TpTarget then
            pcall(function() tpTo(TpTarget) end)
            task.wait(0.5)
        else
            task.wait(0.5)
        end
    end
end)

local OrbitOn = false
local OrbitA = 0

task.spawn(function()
    while true do
        if OrbitOn and TpTarget then
            pcall(function()
                local p = Players:FindFirstChild(TpTarget)
                local tch = p and p.Character
                local thr = tch and tch:FindFirstChild("HumanoidRootPart")
                local c = lp.Character
                local root = c and c:FindFirstChild("HumanoidRootPart")
                if thr and root then
                    OrbitA = OrbitA + 0.3
                    root.CFrame = thr.CFrame * CFrame.new(math.cos(OrbitA) * 6, 2, math.sin(OrbitA) * 6)
                end
            end)
            task.wait()
        else
            task.wait(0.5)
        end
    end
end)

