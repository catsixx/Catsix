local function remoteOf(tool)
    for _, n in ipairs(RNAMES) do
        local r = tool:FindFirstChild(n, true)
        if r and r:IsA("RemoteEvent") then
            return r
        end
    end
    return nil
end

local function alive(v)
    if v == lp then return false end
    if not v.Character then return false end
    if v.Character:FindFirstChildOfClass("ForceField") then return false end
    local hum = v.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if hum.Health <= 0 then return false end
    local hr = v.Character:FindFirstChild("HumanoidRootPart")
    if not hr then return false end
    return true
end

local function clearShot(from, part, char)
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances = {lp.Character}
    p.IgnoreWater = true
    local dir = part.Position - from
    if dir.Magnitude < 1 then return true end
    local hit = Workspace:Raycast(from, dir, p)
    if not hit then return true end
    if hit.Instance and hit.Instance:IsDescendantOf(char) then return true end
    return false
end

local function closestVisible(pos, from)
    local best = nil
    local bd = math.huge
    for _, v in ipairs(Players:GetPlayers()) do
        if not alive(v) then continue end
        local ch = v.Character
        if not ch then continue end
        local hr = ch:FindFirstChild("HumanoidRootPart")
        if not hr then continue end
        local m = (hr.Position - pos).Magnitude
        if m >= bd then continue end
        local head = ch:FindFirstChild("Head")
        local ok = false
        if head and clearShot(from, head, ch) then ok = true end
        if not ok then if clearShot(from, hr, ch) then ok = true end end
        if not ok then continue end
        bd = m
        best = v
    end
    return best
end

local function getGun()
    local c = lp.Character
    if not c then return nil, nil end
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") and remoteOf(t) then
            return t, remoteOf(t)
        end
    end
    local pack = lp:FindFirstChildOfClass("Backpack")
    if pack then
        for _, t in ipairs(pack:GetChildren()) do
            if not t:IsA("Tool") then continue end
            local r = remoteOf(t)
            if not r then continue end
            local hum = c:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum:EquipTool(t) end) task.wait(0.08) end
            local eq = c:FindFirstChild(t.Name)
            if eq then
                local er = remoteOf(eq)
                if er then return eq, er end
            end
            return t, r
        end
    end
    return nil, nil
end

local function tt()
    local p = 0
    pcall(function() p = lp:GetNetworkPing() end)
    if p > 2 then p = p / 1000 end
    local t = 0.15 + (p or 0) * 0.7
    if t > 0.32 then t = 0.32 end
    if t < 0.05 then t = 0.05 end
    return t
end

local function shoot()
    if Settings.ShootEnabled == false then return end
    if tick() - last < CD then return end
    local c = lp.Character
    if not c then return end
    local root = c:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local headMe = c:FindFirstChild("Head")
    local from = root.Position
    if headMe then from = headMe.Position end
    local target = closestVisible(root.Position, from)
    if not target then return end
    local tch = target.Character
    if not tch then return end
    local tool, remote = getGun()
    if not tool then return end
    if not remote then return end
    local hr = tch:FindFirstChild("HumanoidRootPart")
    if not hr then return end
    local head = tch:FindFirstChild("Head")
    local upper = tch:FindFirstChild("UpperTorso") or tch:FindFirstChild("Torso")
    local enemyHum = tch:FindFirstChildOfClass("Humanoid")
    local air = false
    if enemyHum and enemyHum.FloorMaterial == Enum.Material.Air then air = true end
    if math.abs(hr.Velocity.Y) > 8 then air = true end
    local parts = {}
    if hr then table.insert(parts, hr) end
    if head then table.insert(parts, head) end
    if upper then table.insert(parts, upper) end
    local t = tt()
    local aims = {}
    for _, part in ipairs(parts) do
        if part and clearShot(from, part, tch) then
            local vel = part.Velocity
            if vel.Magnitude > 80 then vel = vel.Unit * 20 end
            table.insert(aims, part.Position + vel * t + Vector3.new(0, 0.15, 0))
            table.insert(aims, part.Position + vel * (t + 0.05) + Vector3.new(0, 0.15, 0))
            table.insert(aims, part.Position + vel * (t + 0.1) + Vector3.new(0, 0.15, 0))
            if air then
                table.insert(aims, part.Position + vel * t + Vector3.new(0, 0.15 - 98 * t * t, 0))
                table.insert(aims, part.Position + vel * (t + 0.08) + Vector3.new(0, 0.15 - 98 * (t + 0.08) * (t + 0.08), 0))
                table.insert(aims, part.Position + Vector3.new(0, 1, 0))
                table.insert(aims, part.Position + Vector3.new(0, -1, 0))
            end
        end
    end
    if #aims == 0 then return end
    last = tick()
    local hand = c:FindFirstChild("RightHand")
    if not hand then hand = root end
    local origin = CFrame.new(hand.Position)
    for _, a in ipairs(aims) do
        pcall(function() remote:FireServer(origin, CFrame.new(a)) end)
        pcall(function() remote:FireServer(a) end)
        pcall(function() remote:FireServer(tch, a) end)
    end
    for i = 1, 10 do pcall(function() remote:FireServer(origin, CFrame.new(aims[1])) end) end
end

