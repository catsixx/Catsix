            Value = { Min = 16, Max = 250, Default = 16 },
            Flag = "WalkSpeed",
            Callback = function(v)
                Settings.WalkSpeed = v
                local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
                if hum and Settings.SpeedEnabled then hum.WalkSpeed = v end
            end,
        })

        MoveSec:Toggle({
            Title = "JumpPower Enabled",
            Value = false,
            Flag = "JumpEnabled",
            Callback = function(v) Settings.JumpEnabled = v end,
        })

        MoveSec:Slider({
            Title = "JumpPower",
            Step = 1,
            Value = { Min = 50, Max = 300, Default = 50 },
            Flag = "JumpPower",
            Callback = function(v)
                Settings.JumpPower = v
                local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
                if hum and Settings.JumpEnabled then
                    pcall(function() hum.JumpPower = v end)
                    pcall(function() hum.JumpHeight = Settings.JumpHeight end)
                end
            end,
        })

        MoveSec:Slider({
            Title = "JumpHeight",
            Step = 0.5,
            Value = { Min = 5, Max = 100, Default = 7 },
            Flag = "JumpHeight",
            Callback = function(v)
