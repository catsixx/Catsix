            Callback = function(v)
                pcall(function() WindUI:SetTheme(v) end)
            end,
        })

        UiSec:Toggle({
            Title = "Transparent Window",
            Desc = "WindUI transparency (black)",
            Value = true,
            Callback = function(v)
                pcall(function()
                    if Window.ToggleTransparency then
                        Window:ToggleTransparency(v)
                    elseif Window.SetTransparent then
                        Window:SetTransparent(v)
                    elseif Window.SetTransparency then
                        Window:SetTransparency(v)
                    end
                end)
            end,
        })

        local CfgSec = SettingsTab:Section({ Title = "Config", Opened = true })

        local ConfigName = "CatsixConfig"
        CfgSec:Input({
            Title = "Config Name",
            Value = "CatsixConfig",
            Callback = function(v)
                if v and v ~= "" then ConfigName = v end
            end,
        })

        CfgSec:Button({
            Title = "Save Config",
            Icon = "save",
            Callback = function()
                pcall(function()
                    local CM = Window.ConfigManager
                    local cfg = nil
                    if CM.CreateConfig then
                        cfg = CM:CreateConfig(ConfigName)
                    elseif CM.Config then
                        cfg = CM:Config(ConfigName)
                    end
                    if cfg and cfg.Save then
                        Window.CurrentConfig = cfg
                        cfg:Save()
                    elseif cfg and cfg.SaveConfig then
                        cfg:SaveConfig()
                    end
                end)
                WindUI:Notify({ Title = "Catsix", Content = "Config saved: " .. tostring(ConfigName), Duration = 2, Icon = "check" })
            end,
        })

        CfgSec:Button({
            Title = "Load Config",
            Icon = "folder-open",
            Callback = function()
                pcall(function()
                    local CM = Window.ConfigManager
                    local cfg = nil
                    if CM.CreateConfig then
                        cfg = CM:CreateConfig(ConfigName)
                    elseif CM.Config then
                        cfg = CM:Config(ConfigName)
                    end
                    if cfg and cfg.Load then
                        Window.CurrentConfig = cfg
                        cfg:Load()
                    end
                end)
                WindUI:Notify({ Title = "Catsix", Content = "Config loaded: " .. tostring(ConfigName), Duration = 2, Icon = "check" })
            end,
        })
